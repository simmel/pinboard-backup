<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="posts">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="post" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:anyAttribute
              processContents="skip"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute type="xs:string" name="user" />
    </xs:complexType>
  </xs:element>
</xs:schema>
